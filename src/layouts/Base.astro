---
import '../styles/global.css';
import { t, rutas, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  titulo: string;
  descripcion: string;
  // Ruta de esta misma página en el otro idioma (para el selector y hreflang).
  alterna: string;
  activa?: 'inicio' | 'herramientas' | 'exploraciones' | 'sobre-mi';
}

const { lang, titulo, descripcion, alterna, activa } = Astro.props;
const otro: Lang = lang === 'es' ? 'en' : 'es';
const s = t(lang);
const tituloCompleto = titulo === 'Miguel Ferreiro García' ? titulo : `${titulo} · Miguel Ferreiro García`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const urlAlterna = new URL(alterna, Astro.site);

const enlaces = [
  { id: 'inicio', href: rutas.inicio[lang], texto: s.nav.inicio },
  { id: 'herramientas', href: rutas.herramientas[lang], texto: s.nav.herramientas },
  { id: 'exploraciones', href: rutas.exploraciones[lang], texto: s.nav.exploraciones },
  { id: 'sobre-mi', href: rutas.sobreMi[lang], texto: s.nav.sobreMi },
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang={lang} href={canonica} />
    <link rel="alternate" hreflang={otro} href={urlAlterna} />
    <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonica : urlAlterna} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Montserrat:wght@400;500;600&family=Geist+Mono:wght@300&display=swap"
    />
  </head>
  <body>
    <a class="saltar" href="#contenido">{s.saltar}</a>
    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <ul class="menu">
            {enlaces.map((e) => (
              <li>
                <a href={e.href} aria-current={activa === e.id ? 'page' : undefined}>{e.texto}</a>
              </li>
            ))}
            <li>
              <a class="idioma" href={alterna} lang={otro} hreflang={otro}>{s.cambiarIdioma}</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -999px;
    top: 8px;
    padding: 8px 12px;
    background: var(--papel);
    border: 1px solid var(--acento);
    border-radius: 6px;
    z-index: 10;
  }
  .saltar:focus { left: 8px; }

  .cabecera {
    border-bottom: 1px solid var(--borde);
    background: var(--fondo);
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding-block: 18px;
  }
  .menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    font-weight: 500;
  }
  .menu a {
    display: inline-block;
    padding: 8px 0 6px;
    color: var(--tinta-3);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .menu a:hover { color: var(--tinta); }
  .menu a[aria-current='page'] { color: var(--tinta); border-bottom-color: var(--acento); }
  .menu .idioma {
    padding: 6px 12px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    font-size: 12px;
    color: var(--tinta);
  }
  .menu .idioma:hover { border-color: var(--acento); }

</style>
