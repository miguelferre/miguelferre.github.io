---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaExploracion from '../TarjetaExploracion.astro';
import Destacado from '../Destacado.astro';
import Icono from '../Icono.astro';
import { t, rutas, cifra, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const p = s.portada;
const otro: Lang = lang === 'es' ? 'en' : 'es';

const herramientas = await getCollection('proyectos', (e) => e.data.tipo === 'herramienta');

const exploraciones = await getCollection('proyectos', (e) => e.data.tipo === 'exploracion');
const cv = lang === 'es' ? '/cv/Miguel_Ferreiro_CV_ES.pdf' : '/cv/Miguel_Ferreiro_CV_EN.pdf';
const idHerramientas = lang === 'es' ? 'herramientas' : 'tools';
const idExploraciones = lang === 'es' ? 'exploraciones' : 'explorations';
const idSobreMi = lang === 'es' ? 'sobre-mi' : 'about';
---

<Base lang={lang} titulo="Miguel Ferreiro García" descripcion={p.descripcion} alterna={rutas.inicio[otro]} activa="inicio">
  <section class="tira portada">
    <div class="portada__fondo" aria-hidden="true">
      <div class="mancha"><span class="m1"></span><span class="m2"></span><span class="m3"></span><span class="m4"></span><span class="m5"></span><span class="m6"></span></div>
      <div class="velo"></div>
      <div class="lluvia" data-claves={JSON.stringify(p.claves)}></div>
    </div>
    <div class="contenedor pila pila--ancha limite">
      <h1>Miguel Ferreiro García</h1>
      <p class="lema">{p.lema}</p>
      <div class="subtitulo">{p.subtitulo.map((linea) => <p>{linea}</p>)}</div>
      <div class="botones">
        <a class="boton boton--icono" href="https://github.com/miguelferre" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub"><Icono nombre="github" /></a>
        <a class="boton boton--icono" href="https://www.linkedin.com/in/miguel-ferreiro-garcia" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn"><Icono nombre="linkedin" /></a>
        <a class="boton boton--lleno" href={cv} target="_blank" rel="noopener"><Icono nombre="cv" /> {s.cv}</a>
      </div>
    </div>
  </section>

  <section class="tira tira--papel" id={idHerramientas} aria-labelledby="herramientas-titulo">
    <div class="contenedor pila pila--ancha">
      <div class="pila limite">
        <span class="entradilla">{p.herramientasEntradilla}</span>
        <h2 id="herramientas-titulo">{p.herramientasTitulo}</h2>
      </div>
      <div class="herramientas">
        {herramientas.map((h) => <Destacado lang={lang} proyecto={h} />)}
      </div>
    </div>
  </section>

  <section class="tira" id={idExploraciones} aria-labelledby="exploraciones-titulo">
    <div class="contenedor pila pila--ancha">
      <div class="pila limite">
        <span class="entradilla">{p.exploracionesEntradilla}</span>
        <h2 id="exploraciones-titulo">{p.exploracionesTitulo}</h2>
        <p class="subtitulo" style="font-size: 16px;">{p.exploracionesTexto}</p>
      </div>
      <div class="rejilla rejilla--2">
        {exploraciones.map((e) => <TarjetaExploracion lang={lang} proyecto={e} />)}
      </div>
    </div>
  </section>

  <section class="tira" id={idSobreMi} aria-labelledby="sobre-mi-titulo">
    <div class="contenedor pila pila--ancha limite">
      <span class="entradilla">{p.sobreMiEntradilla}</span>
      <h2 id="sobre-mi-titulo">{p.sobreMiTitulo}</h2>
      <dl class="ficha">
        {p.ficha.map((f) => (
          <div class="ficha__fila"><dt>{f.clave}</dt><dd>{Array.isArray(f.valor) ? <ul class="ficha__lista">{f.valor.map((v) => <li>{v}</li>)}</ul> : f.valor}</dd></div>
        ))}
      </dl>
      <div class="botones">
        <a class="boton boton--icono" href="https://github.com/miguelferre" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub"><Icono nombre="github" /></a>
        <a class="boton boton--icono" href="https://www.linkedin.com/in/miguel-ferreiro-garcia" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn"><Icono nombre="linkedin" /></a>
        <a class="boton boton--lleno" href={cv} target="_blank" rel="noopener"><Icono nombre="cv" /> {s.cv}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Fondo de la portada: rejilla monoespaciada que recorre las palabras clave y enciende fragmentos por tramos
  const lluvia = document.querySelector<HTMLElement>('.portada .lluvia');
  const subtitulo = document.querySelector<HTMLElement>('.portada .subtitulo');
  if (lluvia && subtitulo) {
    const claves: string[] = JSON.parse(lluvia.dataset.claves ?? '[]');
    const flujo = claves.slice().sort(() => Math.random() - 0.5).join('  ') + '  ';
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let celdas: HTMLElement[] = [];

    const pinta = (c: HTMLElement, on: boolean) => {
      const ch = c.dataset.ch ?? ' ';
      c.textContent = on ? ch : ' ';
      c.style.setProperty('--o', on && ch !== ' ' ? (0.45 + Math.random() * 0.45).toFixed(2) : '0');
    };

    const construye = () => {
      // La zona atenuada llega hasta donde acaba la línea más larga del subtítulo
      const caja = lluvia.getBoundingClientRect();
      const rango = document.createRange();
      rango.selectNodeContents(subtitulo);
      const borde = rango.getBoundingClientRect().right;
      lluvia.style.setProperty('--hueco', Math.min(100, ((borde - caja.left) / caja.width) * 100 + 2).toFixed(1) + '%');

      const fs = parseFloat(getComputedStyle(lluvia).fontSize);
      const paso = fs * 1.05, alto = fs * 1.5;
      const cols = Math.ceil(lluvia.clientWidth / paso), filas = Math.ceil(lluvia.clientHeight / alto);
      lluvia.innerHTML = '';
      celdas = [];
      let k = (Math.random() * flujo.length) | 0;
      for (let r = 0; r < filas; r++) {
        const fila = document.createElement('span');
        fila.className = 'fila';
        fila.style.height = alto + 'px';
        let on = Math.random() < 0.3;
        for (let c = 0; c < cols; c++) {
          const i = document.createElement('i');
          i.style.width = paso + 'px';
          i.dataset.ch = flujo[k++ % flujo.length];
          if (Math.random() < (on ? 0.25 : 0.12)) on = !on;
          pinta(i, on);
          fila.appendChild(i);
          celdas.push(i);
        }
        lluvia.appendChild(fila);
      }
    };

    // Se reconstruye cuando cambia el tamaño de la sección (también cubre cargas en una pestaña aún sin medir)
    let rt: number | undefined;
    let ancho = -1;
    new ResizeObserver(([e]) => {
      const w = Math.round(e.contentRect.width);
      if (w === ancho) return;
      ancho = w;
      clearTimeout(rt);
      rt = window.setTimeout(construye, celdas.length ? 150 : 0);
    }).observe(lluvia);

    // Parpadeo: cada tick enciende o apaga un tramo corto de una fila
    if (!quieto) {
      setInterval(() => {
        if (!celdas.length) return;
        for (let n = 0; n < 3; n++) {
          const start = (Math.random() * celdas.length) | 0;
          const len = 2 + ((Math.random() * 5) | 0);
          const on = Math.random() < 0.45;
          for (let j = 0; j < len && start + j < celdas.length; j++) pinta(celdas[start + j], on);
        }
      }, 160);
    }
  }
</script>

<style>
  .portada { padding-block: 72px 56px; }

  /* Fondo animado: mancha de color, velo crema tras el texto y lluvia de fragmentos */
  .portada { position: relative; overflow: hidden; isolation: isolate; border-bottom: 1px solid var(--borde); }
  .portada > .contenedor { position: relative; z-index: 2; }
  .portada .subtitulo { color: var(--tinta); font-weight: 500; font-size: 17px; line-height: 1.55; display: flex; flex-direction: column; gap: 10px; max-width: 640px; }
  .portada .lema { font-family: var(--titulos); font-weight: 600; font-size: clamp(20px, 2.4vw, 26px); color: var(--acento); text-wrap: balance; }
  .portada .boton:not(.boton--lleno) { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(6px); }

  .portada__fondo {
    --lavanda: #b7a6e0;
    --periwinkle: #aab6e8;
    --menta: #9fd6c6;
    --oro: #efc24e;
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
  }
  .mancha { position: absolute; inset: -30% -10%; filter: blur(clamp(40px, 6vw, 90px)); }
  .mancha span { position: absolute; border-radius: 50%; animation: deriva var(--t) ease-in-out infinite alternate; }
  .m1 { left: 30%; top: 12%; width: 60%; height: 80%; background: var(--periwinkle); --t: 22s; }
  .m2 { left: 52%; top: 2%;  width: 40%; height: 64%; background: var(--lavanda); --t: 18s; border-radius: 40% 60% 55% 45%; }
  .m3 { left: 70%; top: 30%; width: 28%; height: 56%; background: var(--acento); --t: 20s; opacity: 0.75; }
  .m4 { left: 44%; top: 46%; width: 30%; height: 48%; background: var(--menta); --t: 16s; }
  .m5 { left: 82%; top: 8%;  width: 18%; height: 30%; background: var(--oro); --t: 24s; opacity: 0.8; }
  .m6 { left: 8%;  top: 20%; width: 36%; height: 70%; background: var(--fondo); --t: 26s; }
  @keyframes deriva {
    0%   { transform: translate(0, 0) scale(1) rotate(0); }
    50%  { transform: translate(3%, -3%) scale(1.07) rotate(7deg); }
    100% { transform: translate(-3%, 3%) scale(0.95) rotate(-5deg); }
  }

  .velo {
    position: absolute; inset: 0;
    background: linear-gradient(to right, var(--fondo) 0, rgba(246, 244, 239, 0.92) 38%, rgba(246, 244, 239, 0) 62%);
  }

  .lluvia {
    --hueco: 56%;
    position: absolute; inset: 0;
    font: 300 clamp(14px, 1.3vw, 19px) / 1 'Geist Mono', ui-monospace, monospace;
    color: #fff;
    white-space: pre;
    /* Se desvanece arriba y abajo, y casi desaparece en la columna del texto */
    -webkit-mask-image:
      linear-gradient(to bottom, transparent, #000 18%, #000 78%, transparent),
      linear-gradient(to right, rgba(0, 0, 0, 0.18) 0, rgba(0, 0, 0, 0.18) var(--hueco), #000 calc(var(--hueco) + 14%));
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, transparent, #000 18%, #000 78%, transparent),
      linear-gradient(to right, rgba(0, 0, 0, 0.18) 0, rgba(0, 0, 0, 0.18) var(--hueco), #000 calc(var(--hueco) + 14%));
    mask-composite: intersect;
  }
  /* Los nodos se crean en el script: fuera del ámbito de Astro, de ahí :global */
  .lluvia :global(.fila) { display: flex; }
  .lluvia :global(i) { font-style: normal; flex: none; text-align: center; opacity: var(--o, 0.6); transition: opacity 1.4s ease; }

  @media (max-width: 720px) {
    .velo { background: linear-gradient(to right, rgba(246, 244, 239, 0.9) 0, rgba(246, 244, 239, 0.75) 70%, rgba(246, 244, 239, 0.2) 100%); }
    .m3 { opacity: 0.3; }
    .m1 { left: 46%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mancha span { animation: none; }
    .lluvia :global(i) { transition: none; }
  }

  .herramientas { display: flex; flex-direction: column; gap: 56px; }

  /* Ficha de «Sobre mí»: clave a la izquierda, valor a la derecha */
  .ficha { margin: 0; border-top: 1px solid var(--borde); }
  .ficha__fila { display: grid; grid-template-columns: 1fr; gap: 2px 24px; padding: 12px 0; border-bottom: 1px solid var(--borde); }
  @media (min-width: 640px) { .ficha__fila { grid-template-columns: 160px minmax(0, 1fr); } }
  .ficha dt { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--tinta-3); padding-top: 3px; }
  .ficha dd { margin: 0; color: var(--tinta-2); text-wrap: pretty; }
  .ficha__lista { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
  .ficha__lista li::marker { color: var(--acento); }
</style>
