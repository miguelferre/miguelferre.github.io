---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaExploracion from '../TarjetaExploracion.astro';
import { t, rutas, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const p = s.portada;
const otro: Lang = lang === 'es' ? 'en' : 'es';

const revisor = await getEntry('proyectos', 'revisor');
if (!revisor) throw new Error('Falta la entrada "revisor" en proyectos.yaml');
const r = revisor.data;

const exploraciones = await getCollection('proyectos', (e) => e.data.tipo === 'exploracion');
const cv = lang === 'es' ? '/cv/Miguel_Ferreiro_CV_ES.pdf' : '/cv/Miguel_Ferreiro_CV_EN.pdf';
const idExploraciones = lang === 'es' ? 'exploraciones' : 'explorations';
const idSobreMi = lang === 'es' ? 'sobre-mi' : 'about';
---

<Base lang={lang} titulo="Miguel Ferreiro García" descripcion={p.descripcion} alterna={rutas.inicio[otro]} activa="inicio">
  <section class="tira portada">
    <div class="contenedor pila pila--ancha limite">
      <h1>Miguel Ferreiro García</h1>
      <p class="subtitulo">{p.subtitulo}</p>
      <div class="botones">
        <a class="boton boton--lleno" href="https://github.com/miguelferre">GitHub</a>
        <a class="boton" href="https://www.linkedin.com/in/miguel-ferreiro-garcia">LinkedIn</a>
        <a class="boton" href={cv}>{s.cv}</a>
      </div>
    </div>
  </section>

  <section class="tira tira--papel" aria-labelledby="herramienta">
    <div class="contenedor pila pila--ancha">
      <div class="pila limite">
        <span class="entradilla">{p.herramientaEntradilla}</span>
        <h2 id="herramienta">{r.pregunta[lang]}</h2>
      </div>
      <div class="destacado">
        <a class="destacado__captura" href={r.url_informe} aria-label={p.abrirInforme}>
          <img src={r.captura} alt={r.captura_alt?.[lang] ?? ''} width="1280" height="720" />
        </a>
        <div class="pila pila--ancha">
          <h3>{r.nombre}</h3>
          <p class="destacado__texto">{r.resumen[lang]}</p>
          {r.metricas && (
            <div class="cifras">
              {r.metricas.map((m) => (
                <div class="cifra">
                  <span class="cifra__valor">{lang === 'en' ? m.valor.replace(',', '.') : m.valor}</span>
                  <span class="cifra__etiqueta">{m.etiqueta[lang]}</span>
                </div>
              ))}
            </div>
          )}
          {r.marcos && (
            <ul class="chips" aria-label={p.marcos}>
              {r.marcos.map((m) => <li class="chip">{m}</li>)}
            </ul>
          )}
          <div class="botones">
            <a class="boton boton--lleno" href={rutas.revisor[lang]}>{p.verFicha}</a>
            <a class="boton" href={r.url_informe}>{p.informeEjemplo}</a>
            <a class="boton" href={r.url_repo}>{p.repo}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tira" id={idExploraciones} aria-labelledby="exploraciones-titulo">
    <div class="contenedor pila pila--ancha">
      <div class="pila limite">
        <span class="entradilla">{p.exploracionesEntradilla}</span>
        <h2 id="exploraciones-titulo">{p.exploracionesTitulo}</h2>
        <p class="subtitulo" style="font-size: 16px;">{p.exploracionesTexto}</p>
      </div>
      <div class="rejilla rejilla--2">
        {exploraciones.map((e) => <TarjetaExploracion lang={lang} proyecto={e} />)}
      </div>
    </div>
  </section>

  <section class="tira tira--papel" aria-labelledby="privado">
    <div class="contenedor pila pila--ancha">
      <span class="entradilla" id="privado">{p.privadoEntradilla}</span>
      <div class="rejilla rejilla--3">
        {p.privado.map((f) => (
          <div class="ficha-corta">
            <span class="ficha-corta__meta">{f.meta}</span>
            <span class="ficha-corta__titulo">{f.titulo}</span>
            <span class="ficha-corta__texto">{f.texto}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="tira" id={idSobreMi} aria-labelledby="sobre-mi-titulo">
    <div class="contenedor pila pila--ancha limite">
      <span class="entradilla">{p.sobreMiEntradilla}</span>
      <h2 id="sobre-mi-titulo">{p.sobreMiTitulo}</h2>
      <p>{p.sobreMiTexto}</p>
      <div class="botones">
        <a class="boton" href="https://www.linkedin.com/in/miguel-ferreiro-garcia">{p.perfilLinkedIn}</a>
        <a class="boton" href={cv}>{s.cv}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .portada { padding-block: 72px 56px; }

  .destacado {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .destacado { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
  }
  .destacado__captura {
    display: block;
    border-radius: 12px;
    border: 1px solid var(--borde);
    overflow: hidden;
    background: #e8e4da;
    max-height: 340px;
  }
  .destacado__captura img { display: block; width: 100%; height: 100%; max-height: 340px; object-fit: cover; object-position: top; }
  .destacado__texto { color: var(--tinta-2); }

  .ficha-corta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid var(--borde);
  }
  .ficha-corta__meta { font-size: 12px; color: var(--tinta-3); }
  .ficha-corta__titulo { font-family: var(--titulos); font-weight: 600; font-size: 16px; }
  .ficha-corta__texto { font-size: 13px; color: var(--tinta-2); }
</style>
