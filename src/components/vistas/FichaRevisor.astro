---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, rutas, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const v = s.revisor;
const otro: Lang = lang === 'es' ? 'en' : 'es';

const revisor = await getEntry('proyectos', 'revisor');
if (!revisor) throw new Error('Falta la entrada "revisor" en proyectos.yaml');
const r = revisor.data;

const REPO = 'https://github.com/miguelferre/human-ai-governance';
const DECK_FLOOD = `${REPO}/blob/master/docs/presentacion/export/interaction-review-floods${lang === 'en' ? '-en' : ''}.pdf`;
const DECK_CLINICO = `${REPO}/blob/master/docs/presentacion/export/interaction-review-interna${lang === 'en' ? '-en' : ''}.pdf`;
const ADRS = `${REPO}/tree/master/docs/adr`;
const RESULTADOS = `${REPO}/blob/master/docs/RESULTS.md`;

const anclas = lang === 'es'
  ? { queHace: 'que-hace', validacion: 'validacion', escalera: 'escalera', limites: 'limites' }
  : { queHace: 'what-it-does', validacion: 'validation', escalera: 'ladder', limites: 'limits' };
---

<Base lang={lang} titulo={r.nombre} descripcion={v.descripcion} alterna={rutas.revisor[otro]} activa="herramienta">
  <section class="tira cabecera-ficha">
    <div class="contenedor pila pila--ancha limite">
      <span class="entradilla">{s.portada.herramientaEntradilla}</span>
      <h1>{r.nombre}</h1>
      <p class="subtitulo">{v.subtitulo}</p>
      <div class="botones">
        <a class="boton boton--lleno" href={r.url_informe}>{v.abrirInforme}</a>
        <a class="boton" href={REPO}>Repo</a>
        <a class="boton" href={ADRS}>ADRs</a>
      </div>
    </div>
  </section>

  <nav class="pestanas" aria-label={v.secciones}>
    <div class="contenedor pestanas__fila">
      <a href={`#${anclas.queHace}`}>{v.queHace}</a>
      <a href={`#${anclas.validacion}`}>{v.validacion}</a>
      <a href={`#${anclas.escalera}`}>{lang === 'es' ? 'La escalera' : 'The ladder'}</a>
      <a href={`#${anclas.limites}`}>{v.limites}</a>
    </div>
  </nav>

  <section class="tira" id={anclas.queHace} aria-labelledby="que-hace-titulo">
    <div class="contenedor pila pila--ancha">
      <h2 id="que-hace-titulo">{v.queHace}</h2>
      <div class="dos-columnas">
        <p>{r.resumen[lang]} {v.queHaceTexto}</p>
        <ul class="lista-puntos">
          {v.queHacePuntos.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <ul class="chips" aria-label={s.portada.marcos}>
        {r.marcos?.map((m) => <li class="chip">{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="tira tira--papel" id={anclas.validacion} aria-labelledby="validacion-titulo">
    <div class="contenedor pila pila--ancha">
      <h2 id="validacion-titulo">{v.validacion}</h2>
      <div class="rejilla rejilla--3">
        {v.datos.map((d) => (
          <div class="dato">
            <span class="dato__meta">{d.meta}</span>
            <span class="dato__valor">{d.valor}</span>
            <span class="dato__texto">{d.texto}</span>
          </div>
        ))}
      </div>
      <div class="pila">
        <h3>{v.fueraClinico}</h3>
        <p class="limite">{v.fueraClinicoTexto}</p>
        <ul class="chips" aria-label={v.sectoresTitulo}>
          {v.sectores.map((x) => <li class="chip chip--neutro">{x}</li>)}
        </ul>
        <p class="limite enlace-detalle">{v.detalle} <a href={RESULTADOS}>docs/RESULTS.md</a> {v.detalleFin}</p>
      </div>
    </div>
  </section>

  <section class="tira" id={anclas.escalera} aria-labelledby="escalera-titulo">
    <div class="contenedor pila pila--ancha">
      <h2 id="escalera-titulo">{v.escalera}</h2>
      <ol class="escalera">
        {v.escalones.map((e) => (
          <li class:list={['escalon', { 'escalon--elegido': 'elegido' in e && e.elegido }]}>
            <span class="escalon__codigo">{e.codigo}</span>
            <span class="escalon__nombre">{e.nombre}</span>
            <span class="escalon__nota">{e.nota}</span>
          </li>
        ))}
      </ol>
      <p class="limite">{v.escaleraTexto}</p>
    </div>
  </section>

  <section class="tira tira--papel" id={anclas.limites} aria-labelledby="limites-titulo">
    <div class="contenedor pila pila--ancha">
      <h2 id="limites-titulo">{v.limites}</h2>
      <div class="aviso" role="note">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
        <div>
          <strong>{v.limiteTitulo}</strong>
          {v.limiteTexto}
        </div>
      </div>
      <div class="destacado">
        <a class="destacado__captura" href={r.url_informe} aria-label={s.portada.abrirInforme}>
          <img src={r.captura} alt={r.captura_alt?.[lang] ?? ''} width="1280" height="720" loading="lazy" />
        </a>
        <div class="pila">
          <span class="entradilla" style="color: var(--tinta-3);">{v.informeEntradilla}</span>
          <h3>{v.informeTitulo}</h3>
          <p class="destacado__texto">{v.informeTexto}</p>
          <div class="botones">
            <a class="boton boton--lleno" href={r.url_informe}>{v.abrirElInforme}</a>
            <a class="boton" href={DECK_FLOOD}>{v.deckFlood}</a>
            <a class="boton" href={DECK_CLINICO}>{v.deckClinico}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cabecera-ficha { padding-block: 56px 40px; }

  .pestanas { border-bottom: 1px solid var(--borde); background: var(--fondo); }
  .pestanas__fila { display: flex; flex-wrap: wrap; gap: 4px; }
  .pestanas a {
    display: inline-block;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--tinta-3);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .pestanas a:hover { color: var(--tinta); border-bottom-color: var(--acento); }

  .dos-columnas { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .dos-columnas { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; } }

  .dato {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border-radius: 12px;
    background: var(--fondo);
    border: 1px solid var(--borde);
  }
  .dato__meta { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinta-3); }
  .dato__valor { font-family: var(--titulos); font-weight: 700; font-size: 32px; color: var(--acento); line-height: 1.1; }
  .dato__texto { font-size: 14px; color: var(--tinta-2); }
  .enlace-detalle { font-size: 14px; color: var(--tinta-3); }

  .escalera {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) { .escalera { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .escalon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    border-radius: 10px;
    background: var(--papel);
    border: 1px solid var(--borde);
  }
  .escalon__codigo { font-size: 11px; font-weight: 700; color: var(--tinta-3); }
  .escalon__nombre { font-family: var(--titulos); font-weight: 600; font-size: 16px; }
  .escalon__nota { font-size: 13px; color: var(--tinta-3); }
  .escalon--elegido { background: var(--acento); border-color: var(--acento); }
  .escalon--elegido .escalon__codigo, .escalon--elegido .escalon__nota { color: #e6e1f7; }
  .escalon--elegido .escalon__nombre { color: #fff; }

  .destacado { display: grid; gap: 24px; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .destacado { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .destacado__captura { display: block; border-radius: 12px; border: 1px solid var(--borde); overflow: hidden; background: #e8e4da; max-height: 300px; }
  .destacado__captura img { display: block; width: 100%; height: 100%; max-height: 300px; object-fit: cover; object-position: top; }
  .destacado__texto { font-size: 14px; color: var(--tinta-2); }
</style>
