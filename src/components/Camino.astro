---
// El camino de «Sobre mí»: etapas con miniaturas en línea que se amplían al pasar el ratón o al enfocar.
// pos: object-position de la miniatura (encuadre), por defecto centrada
interface Foto { src: string; alt: string; pos?: string }
interface Etapa { etiqueta: string; texto: string }
interface Props { etapas: readonly Etapa[]; fotos: Readonly<Record<string, Foto>> }
const { etapas, fotos } = Astro.props;

// "texto [[id]] texto [enlace](url)" → trozos de texto, de foto y de enlace
type Trozo = { texto: string } | { foto: Foto | undefined } | { enlace: string; href: string };
const trozos = (texto: string): Trozo[] =>
  texto.split(/(\[\[\w+\]\]|\[[^\]]+\]\([^)]+\))/).map((t) => {
    const f = t.match(/^\[\[(\w+)\]\]$/);
    if (f) return { foto: fotos[f[1]] };
    const e = t.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return e ? { enlace: e[1], href: e[2] } : { texto: t };
  });

// [texto](correo:) → enlace al correo que se arma al usarlo, para que la dirección no esté en el HTML.
// Va del revés y en dos trozos: un bot que busca «usuario@dominio» en el código no la encuentra.
const CORREO = { u: 'leugimaicragorierref', d: 'moc.liamg' };
---

<ol class="camino">
  {etapas.map((e) => (
    <li class="camino__etapa">
      <h3 class="camino__etiqueta">{e.etiqueta}</h3>
      <p class="camino__texto">
        {trozos(e.texto).map((t) =>
          'foto' in t && t.foto ? (
            <span class="mini" tabindex="0">
              <img class="mini__icono" src={t.foto.src} alt="" loading="lazy" style={t.foto.pos ? `object-position: ${t.foto.pos}` : undefined} />
              <span class="mini__grande" role="img" aria-label={t.foto.alt}>
                <img src={t.foto.src} alt={t.foto.alt} loading="lazy" />
              </span>
            </span>
          ) : 'enlace' in t ? (
            t.href === 'correo:'
              ? <a class="camino__enlace" href="#" data-u={CORREO.u} data-d={CORREO.d}>{t.enlace}</a>
              : t.href.startsWith('#')
              ? <a class="camino__enlace" href={t.href}>{t.enlace}</a>
              : <a class="camino__enlace" href={t.href} target="_blank" rel="noopener">{t.enlace}</a>
          ) : (
            'texto' in t ? t.texto : null
          )
        )}
      </p>
    </li>
  ))}
</ol>

<script>
  // Arma el mailto: al pasar el ratón, al enfocar o al pulsar, nunca al cargar la página
  const del_reves = (s: string) => s.split('').reverse().join('');
  document.querySelectorAll<HTMLAnchorElement>('a[data-u][data-d]').forEach((a) => {
    const arma = () => { a.href = 'mailto:' + del_reves(a.dataset.u!) + String.fromCharCode(64) + del_reves(a.dataset.d!); };
    a.addEventListener('pointerenter', arma, { once: true });
    a.addEventListener('focus', arma, { once: true });
    a.addEventListener('click', arma);
  });

  // Miniaturas: un toque abre la ampliación y otro toque (en ella o en cualquier sitio) la cierra; Escape también
  const minis = [...document.querySelectorAll<HTMLElement>('.mini')];
  const cierra = () => minis.forEach((m) => m.classList.remove('abierta'));
  minis.forEach((m) => m.addEventListener('click', (e) => {
    e.stopPropagation();
    const estaba = m.classList.contains('abierta');
    cierra();
    if (!estaba) m.classList.add('abierta'); else m.blur();
  }));
  document.addEventListener('click', cierra);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { cierra(); (document.activeElement as HTMLElement | null)?.blur(); } });
  window.addEventListener('scroll', cierra, { passive: true });
</script>

<style>
  /* Cada etapa: su título encima y el texto debajo, a todo el ancho de lectura */
  .camino { list-style: none; margin: 0; padding: 0; display: grid; gap: 30px; max-width: 72ch; }
  .camino__etapa { display: grid; gap: 6px; }
  .camino__etiqueta { margin: 0; font-size: 19px; font-weight: 600; line-height: 1.3; color: var(--tinta); text-wrap: balance; }
  .camino__texto { font-size: 17px; line-height: 1.65; color: var(--tinta); text-wrap: pretty; }
  .camino__enlace { color: var(--acento); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .camino__enlace:hover { text-decoration-thickness: 2px; }

  /* Miniatura en línea, del alto de una línea de texto */
  .mini { position: relative; display: inline-block; vertical-align: -0.28em; margin: 0 2px; outline: none; }
  .mini__icono {
    display: block; width: 1.9em; height: 1.35em; object-fit: cover; border-radius: 4px;
    border: 1px solid var(--borde); transition: transform .2s ease;
    box-shadow: 0 1px 2px rgba(31, 29, 43, .22), 0 2px 6px rgba(31, 29, 43, .14);
  }
  .mini:hover .mini__icono, .mini:focus-visible .mini__icono { transform: scale(1.08); }
  .mini:focus-visible .mini__icono { outline: 2px solid var(--acento); outline-offset: 2px; }

  /* Ampliada: centrada en la pantalla, como una ventana sobre la página.
     left/right 0 + margin auto: con left 50 % el navegador solo le daba medio ancho y en el móvil salía pequeña */
  .mini__grande {
    position: fixed; z-index: 50; left: 0; right: 0; top: 50%; margin-inline: auto;
    width: fit-content; max-width: min(560px, 94vw); padding: 0; border-radius: 12px; overflow: hidden;
    background: transparent; box-shadow: 0 24px 64px rgba(31, 29, 43, .32);
    display: none; pointer-events: none; transform: translateY(-50%);
  }
  /* La foto tal cual, sin marco: la caja se ajusta a la imagen */
  .mini__grande img { display: block; width: auto; max-width: min(560px, 94vw); height: auto; max-height: 80vh; }
  /* Se abre al pasar el ratón (solo con ratón), con el teclado o al tocar (clase .abierta, ver el script).
     Oculta con display: none para que no ensanche la página en el móvil */
  @media (hover: hover) { .mini:hover .mini__grande { display: block; animation: aparece .18s ease; } }
  .mini:focus-visible .mini__grande, .mini.abierta .mini__grande { display: block; animation: aparece .18s ease; }
  /* Al tocar: fondo oscurecido y la propia ampliación también cierra */
  .mini.abierta .mini__grande { pointer-events: auto; cursor: zoom-out; box-shadow: 0 0 0 100vmax rgba(31, 29, 43, .55), 0 24px 64px rgba(31, 29, 43, .32); }
  @keyframes aparece {
    from { opacity: 0; transform: translateY(-48%) scale(.97); }
    to { opacity: 1; transform: translateY(-50%) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mini__icono { transition: none; }
    .mini .mini__grande { animation: none !important; }
  }
</style>
