---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Etiqueta from '../../components/Etiqueta.astro';

export async function getStaticPaths() {
  const exploraciones = await getCollection('proyectos', (p) => p.data.tipo === 'exploracion');
  return exploraciones.map((proyecto, i) => ({
    params: { id: proyecto.id },
    props: { proyecto, siguiente: exploraciones[(i + 1) % exploraciones.length] },
  }));
}

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  siguiente: CollectionEntry<'proyectos'>;
}
const { proyecto, siguiente } = Astro.props;
const d = proyecto.data;
---

<Base titulo={d.nombre} descripcion={`${d.pregunta} ${d.resumen}`} activa="exploraciones">
  <section class="tira cabecera-ficha">
    <div class="contenedor pila pila--ancha limite">
      <nav class="migas" aria-label="Estás en">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/#exploraciones">Exploraciones</a><span aria-hidden="true">/</span>
        <strong>{d.nombre}</strong>
      </nav>
      <div class="fila-etiquetas">
        <span class="entradilla">Exploración geoespacial</span>
        <Etiqueta estado={d.estado} nota={d.estado_nota} />
      </div>
      <h1>{d.pregunta}</h1>
      <p class="subtitulo">{d.intro ?? d.resumen}</p>
      <div class="botones">
        {d.url_live && <a class="boton boton--lleno" href={d.url_live}>Abrir</a>}
        {d.url_repo && <a class="boton" href={d.url_repo}>Repo</a>}
      </div>
      {d.nota_codigo && <p class="nota">{d.nota_codigo}</p>}
    </div>
  </section>

  <section class="tira tira--papel">
    <div class="contenedor cuerpo">
      <div class="cuerpo__captura">
        {d.captura ? (
          <img src={d.captura} alt={`Captura de ${d.nombre}`} width="1280" height="800" />
        ) : (
          <div class="marcador" style="aspect-ratio: 16 / 9; border: 1px solid var(--borde); border-radius: 12px;">
            Sin desplegar todavía. El código está en el repositorio.
          </div>
        )}
      </div>
      {d.como && (
        <div class="cuerpo__como">
          <span class="entradilla" style="color: var(--tinta-3);">Cómo está hecho</span>
          <ul class="lista-puntos">
            {d.como.map((linea) => <li>{linea}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  {d.aprendi && (
    <section class="tira">
      <div class="contenedor pila limite">
        <span class="entradilla" style="color: var(--tinta-3);">Lo que aprendí</span>
        <p>{d.aprendi}</p>
      </div>
    </section>
  )}

  <section class="tira pie-ficha">
    <div class="contenedor pie-ficha__fila">
      <a href="/#exploraciones">Todas las exploraciones</a>
      <a href={`/exploraciones/${siguiente.id}/`}>Siguiente: {siguiente.data.nombre}</a>
    </div>
  </section>
</Base>

<style>
  .cabecera-ficha { padding-block: 32px 40px; }
  .fila-etiquetas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .nota { font-size: 13px; color: var(--tinta-3); }

  .cuerpo { display: grid; gap: 24px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) { .cuerpo { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); } }
  .cuerpo__captura img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--borde);
    background: #e8e4da;
  }
  .cuerpo__como {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border-radius: 12px;
    background: var(--fondo);
    border: 1px solid var(--borde);
  }

  .pie-ficha { padding-block: 24px; border-top: 1px solid var(--borde); }
  .pie-ficha__fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 14px; }
  .pie-ficha__fila a:first-child { color: var(--tinta-3); text-decoration: none; }
  .pie-ficha__fila a:last-child { font-weight: 600; text-decoration: none; }
</style>
